# Щогодини вдень о :40 (08:40 … 19:40), з випадковою затримкою до 2 хв, пропущені
# запуски не наздоганяються. Зсув від :25 диспетчера, щоб пошта й форми не стартували
# разом. Останній старт о 19:40: з 19:45 (10 хв до дедлайну hand-off 19:55) прохід не
# починає нових живих подач, тож він закінчується до 19:55 і задовго до вечірнього рану
# о 20:30. Поки прохід чекає оператора, наступний тік не стартує: oneshot-сервіс того
# самого інстансу ще активний.
[Unit]
Description=jobsearch browser apply worker timer (%i)

[Timer]
OnCalendar=*-*-* 08..19:40:00
RandomizedDelaySec=120
Persistent=false

[Install]
WantedBy=timers.target
