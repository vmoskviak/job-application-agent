# Hourly during the day at :40 (08:40 ... 19:40) with a random delay of up to 2 min;
# missed runs are not caught up. Offset from the dispatcher's :25 so mail and forms do
# not start together. Last start at 19:40: from 19:45 (10 min before the 19:55 hand-off
# deadline) a pass starts no new live applications, so it finishes before 19:55 and well
# before the evening run at 20:30. While a pass waits for the operator the next tick does
# not start: the oneshot service of the same instance is still active.
[Unit]
Description=jobsearch browser apply worker timer (%i)

[Timer]
OnCalendar=*-*-* 08..19:40:00
RandomizedDelaySec=120
Persistent=false

[Install]
WantedBy=timers.target
