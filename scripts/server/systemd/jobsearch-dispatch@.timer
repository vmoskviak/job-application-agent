# Every half hour during the day at :25 (08:25 ... 20:25) with a random delay of up to 2 min;
# missed runs are not caught up. The evening run at 20:30 fills the queue, the first application goes out in the morning.
[Unit]
Description=jobsearch lead dispatch timer (%i)

[Timer]
OnCalendar=*-*-* 08..20:25:00
RandomizedDelaySec=120
Persistent=false

[Install]
WantedBy=timers.target
