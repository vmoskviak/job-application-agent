# One pass of the application dispatcher for one client; started by jobsearch-dispatch@<slug>.timer.
# Shadow week: JOBSEARCH_DISPATCH_DRY_RUN=1 in /root/.claude-env (do not edit the unit:
# for a oneshot, a drop-in with ExecStart= adds a second run instead of replacing the first).
[Unit]
Description=jobsearch lead dispatch (%i)
After=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/jobsearch-autopilot/scripts/server/run_service.sh scripts/dispatch_leads.py %i
