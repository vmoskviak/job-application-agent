# Hourly during the day at :10 (07:10 ... 23:10) with a random delay of up to 2 min;
# missed runs are not caught up. At night the engine's cron runs take over.
[Unit]
Description=jobsearch inbox watch timer (%i)

[Timer]
OnCalendar=*-*-* 07..23:10:00
RandomizedDelaySec=120
Persistent=false

[Install]
WantedBy=timers.target
