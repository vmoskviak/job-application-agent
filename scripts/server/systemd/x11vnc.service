# VNC on display :99, localhost only and with a password: reachable from outside only
# through an SSH tunnel. Password file: x11vnc -storepasswd /root/.vnc/passwd
[Unit]
Description=x11vnc on display :99, localhost only, password file
After=xvfb.service
BindsTo=xvfb.service

[Service]
ExecStart=/usr/bin/x11vnc -display :99 -rfbauth /root/.vnc/passwd -localhost -forever -shared -o /root/x11vnc.log
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
