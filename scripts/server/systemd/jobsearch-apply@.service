# One pass of the browser worker for one client: login-free ATS forms from the lead
# queue; started by the jobsearch-apply@<slug>.timer. The browser is visible on display
# :99 (Xvfb) so the operator can finish a hand-off over VNC in the same tab; a pass with
# a hand-off waits for the operator until JOBSEARCH_HANDOFF_UNTIL (19:55), hence the
# long TimeoutStartSec.
# Shadow week: JOBSEARCH_APPLY_DRY_RUN=1 in /root/.claude-env (do not edit the unit:
# for a oneshot, a drop-in with ExecStart= adds a second run instead of replacing the first).
[Unit]
Description=jobsearch browser apply worker (%i)
After=network-online.target

[Service]
Type=oneshot
Environment=DISPLAY=:99
ExecStart=/opt/jobsearch-autopilot/scripts/server/run_service.sh scripts/apply_leads.py %i
TimeoutStartSec=12h
