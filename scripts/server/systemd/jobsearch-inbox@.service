# One pass of the inbox watcher for one client; started by jobsearch-inbox@<slug>.timer.
# Shadow week: JOBSEARCH_INBOX_DRY_RUN=1 in /root/.claude-env (do not edit the unit:
# for a oneshot, a drop-in with ExecStart= adds a second run instead of replacing the first).
[Unit]
Description=jobsearch inbox watch (%i)
After=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/jobsearch-autopilot/scripts/server/run_service.sh scripts/inbox_watch.py %i --days 2
